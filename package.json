{
  "name": "bank-it",
  "version": "1.0.0",
  "private": true,
  "description": "BANK IT: a trick-shot basketball game for LeoToby. Take the scenic route.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:leotoby": "tsc --noEmit && vite build --base=/games/bank-it/ --outDir dist-leotoby --emptyOutDir",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "copy:leotoby": "node scripts/copy-to-leotoby.mjs",
    "sweep": "node scripts/sweep.ts",
    "solutions": "node scripts/solutions.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@dimforge/rapier2d-deterministic-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
